# URL de tu servidor principal en la nube o local (sin la barra final /)
CENTRAL_URL=http://localhost:8000

# Token secreto de este kiosko (Lo encuentras en tu panel de admin)
KIOSK_API_TOKEN=pon_tu_token_aqui

# Nombre físico de tu kiosko (solo para referencia en logs locales)
KIOSK_NAME=Mi Primer Kiosko

# Nombre exacto de tu impresora en Windows (Panel de Control -> Impresoras)
# Si lo dejas vacío, usará la impresora predeterminada de Windows
PRINTER_NAME=HP_LaserJet

# [Opcional] Credenciales de Supabase si usas WebSockets para instantaneidad
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anonima

# Cada cuántos milisegundos debe preguntar si hay órdenes (Fallback, 5000 = 5 seg)
POLL_INTERVAL_MS=5000

# Carpetas donde guarda PDFs antes de imprimir
DOWNLOAD_DIR=downloads
OUTPUT_DIR=output